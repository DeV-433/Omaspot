#!/usr/bin/env bash
# Omaspot's backend adapter. It drives create_ap (linux-wifi-hotspot), the
# same engine the wihotspot GUI uses, and speaks a line protocol to QML so
# every operation remains a non-blocking Quickshell Process.
#
# Lifecycle model: create_ap is started in the FOREGROUND under pkexec and
# held open for the hotspot's lifetime, exactly like the wihotspot GUI.
# Daemon mode is deliberately not used: pkexec's transient scope tears down
# detached children when pkexec itself exits, so --daemon silently dies.
# The root-side processes survive even if this holder is killed, and
# `create_ap --stop` remains the single sanctioned stop path.
#
# Trust model: everything under /tmp is attacker-reachable, because /tmp is
# world-writable and any local user can create /tmp/create_ap.<name>.conf.<id>
# owned by themselves. create_ap --stop signals whatever pid it is handed, so a
# spoofed state directory turns the stop path into an arbitrary root signal.
# Nothing read out of /tmp is therefore believed until it has been proven to be
# root-owned and unwritable by anyone else, and every pid is matched against
# /proc before it reaches a privileged command.
set -u
set -o pipefail

CREATE_AP_BIN=/usr/bin/create_ap

# Keep this identical to Panel.qml's statePath. Quickshell and its child
# Process can carry different XDG_STATE_HOME values, while Omarchy's plugin
# state contract here is explicitly ~/.local/state/omarchy/settings.
STATE_DIR="$HOME/.local/state/omarchy/settings"
RUN_DIR="$STATE_DIR/omaspot"
LOG_FILE="$RUN_DIR/create_ap.log"
# Our own record of the instance we last validated. Private to this user, so it
# is authoritative in a way the shared /tmp state can never be.
STATE_FILE="$RUN_DIR/instance"

# Populated by discover_instance once every check below has passed.
INST_CONF=''
INST_PID=''
INST_IFACE=''
INST_STARTTIME=''

die() {
  printf 'omaspot: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "Missing dependency: $1"
}

as_root() {
  # linux-wifi-hotspot ships a polkit action (org.opensuse.policykit.create-ap)
  # that authorizes an active session, so this normally runs without prompts.
  # The absolute path matches the action's exec.path annotation exactly.
  pkexec --user root "$CREATE_AP_BIN" "$@"
}

# A pid arrives from a file, so accept only a plain decimal that no privilege
# boundary has to interpret. No sign, no whitespace, no leading zero, no leading
# dash that create_ap could mistake for one of its own options.
valid_pid() {
  case "$1" in
    '' | *[!0-9]*) return 1 ;;
  esac
  # No leading zeros: bash reads those as octal, so 007 would address pid 7
  # rather than the process whose decimal pid is 7.
  case "$1" in
    0[0-9]*) return 1 ;;
  esac
  [ "${#1}" -le 10 ] || return 1
  [ "$1" -ge 2 ] 2>/dev/null || return 1
}

# Interface names are interpolated into pkexec/create_ap arguments, so allow
# only kernel-legal characters, within IFNAMSIZ, never starting with a dash.
valid_iface() {
  [ -n "$1" ] || return 1
  [ "${#1}" -le 15 ] || return 1
  case "$1" in
    -*) return 1 ;;
    *[!A-Za-z0-9_.-]*) return 1 ;;
  esac
}

# First line only, trimmed. These files are attacker-reachable in general, so
# never hand a whole file to a command.
read_state_line() {
  local line=''
  [ -f "$1" ] || return 0
  IFS= read -r line <"$1" 2>/dev/null || true
  line="${line%$'\r'}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  printf '%s' "$line"
}

is_symlink() {
  [ -L "$1" ]
}

# Group- or other-writable means any local user can rewrite the contents, which
# is exactly what would make a spoofed instance indistinguishable from a real one.
group_or_world_writable() {
  local mode
  mode="$(stat -c '%a' -- "$1" 2>/dev/null)" || return 1
  [ "${#mode}" -gt 3 ] && mode="${mode: -3}"
  [ -n "$mode" ] || return 1
  [ $((8#$mode & 8#022)) -ne 0 ]
}

# Root-owned and unwritable by anyone else. create_ap chmods its conf dir to 755
# on purpose so --list-running works for any user, so the requirement is "not
# writable by others" rather than "0700".
root_owned_unwritable() {
  local path="$1" uid
  [ -e "$path" ] || return 1
  is_symlink "$path" && return 1
  uid="$(stat -c '%u' -- "$path" 2>/dev/null)" || return 1
  [ "$uid" = "0" ] || return 1
  group_or_world_writable "$path" && return 1
  return 0
}

# A regular, non-symlink, root-owned file no local user can rewrite.
trusted_state_file() {
  local path="$1"
  [ -f "$path" ] || return 1
  is_symlink "$path" && return 1
  root_owned_unwritable "$path"
}

# The /tmp state directory itself must be genuine. Matching the create_ap naming
# is not enough on its own -- a user can pick any suffix they like -- so also
# require root ownership and no write bit for group or other.
trusted_conf_dir() {
  local dir="$1" name
  [ -d "$dir" ] || return 1
  is_symlink "$dir" && return 1
  case "$dir" in
    /tmp/create_ap.*.conf.*) ;;
    *) return 1 ;;
  esac
  root_owned_unwritable "$dir" || return 1
  for name in pid wifi_iface; do
    trusted_state_file "$dir/$name" || return 1
  done
  return 0
}

# Field 22 of /proc/<pid>/stat is the process start time in clock ticks since
# boot. It is the only cheap way to tell the pid we validated from a later
# process that merely inherited the same number. comm is parenthesised and may
# itself contain spaces, so split after the final ')'.
proc_starttime() {
  local pid="$1" stat_line rest
  [ -r "/proc/$pid/stat" ] || return 1
  IFS= read -r stat_line <"/proc/$pid/stat" 2>/dev/null || return 1
  rest="${stat_line##*) }"
  # shellcheck disable=SC2086
  set -- $rest
  [ "$#" -ge 20 ] || return 1
  case "${20}" in
    '' | *[!0-9]*) return 1 ;;
  esac
  printf '%s' "${20}"
}

# create_ap is a `#!/usr/bin/env bash` script, so /proc/<pid>/comm is "bash" for
# every instance and cannot identify anything -- trusting comm would accept any
# shell. The script path in argv is the stable token instead, and the process
# must be running as root because pkexec started it.
pid_is_create_ap() {
  local pid="$1" arg found=0
  valid_pid "$pid" || return 1
  [ -d "/proc/$pid" ] || return 1
  [ "$(stat -c '%u' -- "/proc/$pid" 2>/dev/null)" = "0" ] || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  while IFS= read -r -d '' arg; do
    case "${arg##*/}" in
      create_ap)
        found=1
        break
        ;;
    esac
  done <"/proc/$pid/cmdline" 2>/dev/null
  [ "$found" -eq 1 ]
}

secure_run_dir() {
  mkdir -p "$RUN_DIR" 2>/dev/null || return 1
  chmod 0700 "$RUN_DIR" 2>/dev/null || true
}

record_field() {
  local key="$1" line name
  [ -f "$STATE_FILE" ] || return 0
  is_symlink "$STATE_FILE" && return 0
  while IFS= read -r line || [ -n "$line" ]; do
    name="${line%%=*}"
    [ "$name" = "$key" ] || continue
    printf '%s' "${line#*=}"
    return 0
  done <"$STATE_FILE"
}

record_instance() {
  secure_run_dir || return 0
  (
    umask 077
    printf 'pid=%s\nwifi_iface=%s\nstarttime=%s\nconfdir=%s\n' \
      "$1" "$2" "$3" "$4" >"$STATE_FILE.tmp" && mv -f "$STATE_FILE.tmp" "$STATE_FILE"
  ) 2>/dev/null || true
}

clear_record() {
  rm -f "$STATE_FILE" "$STATE_FILE.tmp" 2>/dev/null || true
}

# Fills INST_* with an instance that passed every check, or returns non-zero
# when nothing trustworthy is running. Discovery order is irrelevant because a
# spoofed directory cannot clear trusted_conf_dir.
discover_instance() {
  local dir pid iface starttime
  INST_CONF=''
  INST_PID=''
  INST_IFACE=''
  INST_STARTTIME=''

  for dir in /tmp/create_ap.*.conf.*; do
    trusted_conf_dir "$dir" || continue
    pid="$(read_state_line "$dir/pid")"
    valid_pid "$pid" || continue
    pid_is_create_ap "$pid" || continue
    starttime="$(proc_starttime "$pid")" || continue
    iface="$(read_state_line "$dir/wifi_iface")"
    valid_iface "$iface" || continue
    INST_CONF="$dir"
    INST_PID="$pid"
    INST_IFACE="$iface"
    INST_STARTTIME="$starttime"
    return 0
  done
  return 1
}

interfaces() {
  need nmcli
  nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null \
    | while IFS=: read -r device type state connection; do
        [ -n "$device" ] || continue
        case "$type" in
          wifi) printf '%s\twifi\t%s\n' "$device" "$state" ;;
          ethernet) printf '%s\tethernet\t%s\n' "$device" "$state" ;;
        esac
      done
}

running_record() {
  local log_tail
  if discover_instance; then
    record_instance "$INST_PID" "$INST_IFACE" "$INST_STARTTIME" "$INST_CONF"
    printf 'active\t%s\t%s\t\n' "$INST_IFACE" "$INST_PID"
    return 0
  fi

  if [ -r "$LOG_FILE" ] && [ -s "$LOG_FILE" ]; then
    log_tail="$(tail -n 8 "$LOG_FILE" 2>/dev/null | sed '/^[[:space:]]*$/d' | tr '\n' ' ' || true)"
    [ -n "$log_tail" ] && printf 'omaspot: %s\n' "$log_tail" >&2
    : > "$LOG_FILE" 2>/dev/null || true
  fi
  printf 'inactive\t\t\t\n'
}

status() {
  running_record
}

start_create_ap() {
  need nmcli
  local wifi="$1"
  local upstream="$2"
  local band="$3"
  local channel_mode="$4"
  local channel="$5"
  local ssid password

  IFS= read -r ssid || true
  IFS= read -r password || true
  if [ "$wifi" = auto ] || [ -z "$wifi" ]; then
    wifi="$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null \
      | awk -F: '$2 == "wifi" && $1 !~ /^p2p-/ && $3 != "unavailable" { print $1; exit }')"
  fi
  if [ "$upstream" = auto ] || [ -z "$upstream" ]; then
    upstream="$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null \
      | awk -F: '$2 == "ethernet" && $3 == "connected" { print $1; exit }')"
  fi
  [ -n "$wifi" ] || die "No Wi-Fi interface was detected"
  [ -n "$upstream" ] || die "No upstream interface was selected"
  [ -n "$ssid" ] || die "Hotspot name is empty"
  [ "${#ssid}" -le 32 ] || die "Hotspot name is longer than 32 characters"
  [ "${#password}" -ge 8 ] || die "Security key must be at least 8 characters"
  [ "${#password}" -le 63 ] || die "Security key is longer than 63 characters"
  case "$band" in 2.4|5) ;; *) die "Unsupported Wi-Fi band" ;; esac

  # These reach a pkexec command line, so validate before interpolating rather
  # than trusting whatever nmcli or the panel put in front of us.
  valid_iface "$wifi" || die "Invalid Wi-Fi interface name"
  valid_iface "$upstream" || die "Invalid upstream interface name"
  case "$channel_mode" in auto|manual) ;; *) die "Invalid channel mode" ;; esac
  if [ "$channel_mode" = manual ]; then
    case "$channel" in
      '' | *[!0-9]*) die "Invalid Wi-Fi channel" ;;
    esac
    [ "$channel" -ge 1 ] && [ "$channel" -le 196 ] || die "Wi-Fi channel is out of range"
  fi

  if discover_instance; then
    die "A create_ap hotspot is already running (pid $INST_PID)"
  fi

  secure_run_dir || die "Cannot create the state directory: $RUN_DIR"
  : > "$LOG_FILE"
  chmod 0600 "$LOG_FILE"

  # /etc/create_ap.conf carries the user's tuned defaults (gateway, sharing
  # method, MAC filter, ...). Load it first, then override with the panel's
  # live values so both GUI habits and panel edits are honored.
  local args=()
  if [ -r /etc/create_ap.conf ]; then
    args+=(--config /etc/create_ap.conf)
  fi
  args+=(--freq-band "$band")
  if [ "$channel_mode" = manual ]; then
    args+=(-c "$channel")
  fi
  args+=("$wifi" "$upstream")

  # create_ap reads SSID/passphrase from stdin when not attached to a tty, so
  # credentials never appear in the pkexec command line or shell history.
  # The process is held open (like the wihotspot GUI) until the hotspot stops;
  # its output is captured live so failures can be shown from the log tail.
  printf '%s\n%s\n' "$ssid" "$password" | as_root "${args[@]}" >"$LOG_FILE" 2>&1
  local rc=$?

  # create_ap exits 0 after a clean stop (SIGUSR1 from `create_ap --stop`),
  # and non-zero when it fails; pkexec propagates the code. So the exit
  # status alone separates a deliberate shutdown from a real failure.
  if [ "$rc" -eq 0 ]; then
    : > "$LOG_FILE" 2>/dev/null || true
    return 0
  fi

  local log_tail
  log_tail="$(tail -n 8 "$LOG_FILE" 2>/dev/null | sed '/^[[:space:]]*$/d' | tr '\n' ' ' || true)"
  if [ -n "$log_tail" ]; then
    printf 'omaspot: %s\n' "$log_tail" >&2
  elif [ "$rc" -eq 126 ]; then
    printf 'omaspot: Polkit authorization was cancelled\n' >&2
  else
    printf 'omaspot: The hotspot exited unexpectedly (code %s)\n' "$rc" >&2
  fi
  return 1
}

stop_hotspot() {
  local want="$1" pid saved_pid saved_starttime
  valid_iface "$want" || [ "$want" = auto ] || die "Invalid Wi-Fi interface name"

  # A pid we recorded earlier but whose start time no longer matches has been
  # recycled: the create_ap we knew about is gone and the number now belongs to
  # something unrelated, so refuse rather than signal it.
  saved_pid="$(record_field pid)"
  saved_starttime="$(record_field starttime)"
  discover_instance || return 0

  if [ -n "$saved_pid" ] && [ "$saved_pid" = "$INST_PID" ] &&
    [ -n "$saved_starttime" ] && [ "$saved_starttime" != "$INST_STARTTIME" ]; then
    printf 'omaspot: refusing to signal recycled pid %s\n' "$INST_PID" >&2
    clear_record
    return 0
  fi

  if [ "$want" != auto ] && [ "$INST_IFACE" != "$want" ]; then
    printf 'omaspot: no validated hotspot on %s (running on %s)\n' "$want" "$INST_IFACE" >&2
    return 0
  fi

  pid="$INST_PID"

  # Everything below re-checks the pid immediately before the privileged call.
  # It was read from a file, and between discovery and signalling the process can
  # exit and its number can be handed to something else entirely.
  if ! pid_is_create_ap "$pid" ||
    [ "$(proc_starttime "$pid" 2>/dev/null)" != "$INST_STARTTIME" ] ||
    [ "$(read_state_line "$INST_CONF/pid")" != "$pid" ]; then
    printf 'omaspot: pid %s failed identity re-check; not signalling\n' "$pid" >&2
    clear_record
    return 0
  fi

  record_instance "$pid" "$INST_IFACE" "$INST_STARTTIME" "$INST_CONF"

  # Signal the daemon the same way the GUI does. The daemon runs as root, so
  # a plain kill is not permitted; --stop sends SIGUSR1 through create_ap.
  as_root --stop "$pid" >/dev/null 2>&1 || true
  # create_ap tears everything down (hostapd, dnsmasq, ap0, iptables) on exit;
  # wait up to 10s for the instance to disappear.
  local waited=0
  while [ "$waited" -lt 40 ]; do
    discover_instance >/dev/null 2>&1 || break
    sleep 0.25
    waited=$((waited + 1))
  done
  clear_record
  : > "$LOG_FILE" 2>/dev/null || true
}

valid_mac() {
  [ "${#1}" -eq 17 ] || return 1
  [[ $1 =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]]
}

valid_ipv4() {
  [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  local octet
  local -a octets=()
  IFS='.' read -r -a octets <<<"$1"
  for octet in "${octets[@]}"; do
    [ "${#octet}" -le 3 ] || return 1
    [ "$octet" -ge 0 ] && [ "$octet" -le 255 ] || return 1
  done
}

# DHCP client names are chosen by whatever joins the hotspot, so they are
# attacker-controlled text. Keep a short conservative subset and drop the rest
# instead of forwarding it to the flyout.
clean_hostname() {
  local name="${1%%$'\t'}"
  case "$name" in
    '' | *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  [ "${#name}" -le 64 ] || return 1
  printf '%s' "$name"
}

# The most recently seen DHCP clients, as tab-separated mac, ip, hostname,
# state. Deliberately avoids `create_ap --list-clients`: that subcommand
# requires root (a polkit prompt on every refresh) and re-resolves its config
# dir through the very /tmp scan this script no longer trusts. dnsmasq.leases
# is created 0644 inside the already-validated conf dir, and iw reads the
# station table unprivileged, so nothing here needs elevation.
clients() {
  local dir iface leases line expiry mac ip host state key
  discover_instance || return 0
  dir="$INST_CONF"
  iface="$INST_IFACE"
  leases="$dir/dnsmasq.leases"

  declare -A seen_expiry=() seen_ip=() seen_host=() associated=()

  if command -v iw >/dev/null 2>&1; then
    while IFS= read -r mac; do
      valid_mac "$mac" || continue
      associated["${mac,,}"]=1
    done < <(iw dev "$iface" station dump 2>/dev/null | awk '$1 ~ /^Station$/ { print $2 }')
  fi

  if [ -r "$leases" ]; then
    # <expiry> <mac> <ip> <hostname> <client-id>; newest lease wins per mac.
    while IFS= read -r line; do
      read -r expiry mac ip host _ <<<"$line"
      case "${expiry:-}" in
        '' | *[!0-9]*) continue ;;
      esac
      valid_mac "${mac:-}" || continue
      valid_ipv4 "${ip:-}" || continue
      host="$(clean_hostname "${host:-}" || true)"
      [ -n "$host" ] || host='*'
      key="${mac,,}"
      if [ -z "${seen_expiry[$key]:-}" ] || [ "$expiry" -gt "${seen_expiry[$key]}" ]; then
        seen_expiry["$key"]="$expiry"
        seen_ip["$key"]="$ip"
        seen_host["$key"]="$host"
      fi
    done < <(head -n 500 "$leases" 2>/dev/null)
  fi

  # Associated stations with no lease row still belong in the list.
  for key in "${!associated[@]}"; do
    [ -n "${seen_expiry[$key]:-}" ] && continue
    seen_expiry["$key"]=0
    seen_ip["$key"]='*'
    seen_host["$key"]='*'
  done

  [ "${#seen_expiry[@]}" -eq 0 ] && return 0

  local -a rows=() top=()
  for key in "${!seen_expiry[@]}"; do
    if [ -n "${associated[$key]:-}" ]; then state=connected; else state=recent; fi
    rows+=("${seen_expiry[$key]}"$'\t'"$key"$'\t'"${seen_ip[$key]}"$'\t'"${seen_host[$key]}"$'\t'"$state")
  done

  # Newest first, then at most three. awk rather than head so the sort never
  # takes a SIGPIPE and leaks a shell error.
  mapfile -t top < <(printf '%s\n' "${rows[@]}" | sort -t$'\t' -k1,1nr | awk 'NR <= 3')

  local line_out
  for line_out in "${top[@]}"; do
    IFS=$'\t' read -r _ mac ip host state <<<"$line_out"
    valid_mac "$mac" || continue
    case "$state" in
      connected | recent) ;;
      *) continue ;;
    esac
    printf '%s\t%s\t%s\t%s\n' "$mac" "$ip" "$host" "$state"
  done
}

qr() {
  need qrencode
  local ssid password payload
  IFS= read -r ssid || true
  IFS= read -r password || true
  [ -n "$ssid" ] || die "Hotspot name is empty"

  # Escape the characters defined by the Wi-Fi QR payload format.
  esc_ssid="$(printf '%s' "$ssid" | sed 's/\\/\\\\/g; s/;/\\;/g; s/,/\\,/g; s/:/\\:/g; s/"/\\"/g')"
  esc_password="$(printf '%s' "$password" | sed 's/\\/\\\\/g; s/;/\\;/g; s/,/\\,/g; s/:/\\:/g; s/"/\\"/g')"
  payload="WIFI:S:${esc_ssid};T:WPA;P:${esc_password};;"
  printf '%s' "$payload" | qrencode -t ASCII -o -
}

deps() {
  local item found=1
  for item in create_ap nmcli qrencode pkexec; do
    if command -v "$item" >/dev/null 2>&1; then
      printf 'ok\t%s\n' "$item"
    else
      printf 'missing\t%s\n' "$item"
      found=0
    fi
  done
  [ "$found" -eq 1 ]
}

command_name="${1:-}"
shift || true
case "$command_name" in
  interfaces) interfaces ;;
  status) status ;;
  deps) deps ;;
  start) [ "$#" -eq 5 ] || die "start expects wifi, upstream, band, channel mode, channel"; start_create_ap "$@" ;;
  stop) [ "$#" -eq 1 ] || die "stop expects a Wi-Fi interface"; stop_hotspot "$1" ;;
  clients) [ "$#" -eq 0 ] || die "clients expects no arguments"; clients ;;
  qr) qr ;;
  *) die "Unknown command: $command_name" ;;
esac
